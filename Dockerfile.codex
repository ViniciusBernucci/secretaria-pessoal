FROM node:22-bookworm-slim
ARG CODEX_VERSION=0.157.1
RUN apt-get update && apt-get install -y --no-install-recommends python3 ca-certificates && rm -rf /var/lib/apt/lists/* && npm install -g @openai/codex@${CODEX_VERSION} && useradd --uid 10001 --create-home agent && mkdir /auth && chown agent:agent /auth
WORKDIR /runner
COPY --chown=agent:agent conversation/codex_gateway.py /runner/gateway.py
USER agent
ENV CODEX_HOME=/auth PYTHONUNBUFFERED=1
CMD ["python3", "/runner/gateway.py"]
